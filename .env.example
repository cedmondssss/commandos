# CommandOS development credentials.
# Copy to .env.local (git-ignored) or, preferably, paste them in the app: Settings → API credentials
# (stored in the macOS Keychain). Keychain values take precedence over these.

# OpenAI — gpt-6-luna (router), gpt-6.1-sol (planner), gpt-6-astra (recovery)
OPENAI_API_KEY=

# ElevenLabs — Scribe v2 Realtime speech-to-text and text-to-speech
ELEVENLABS_API_KEY=

# Daytona — isolated sandboxes for tests, validation scripts and file transforms
DAYTONA_API_KEY=
# optional
DAYTONA_API_URL=
DAYTONA_TARGET=

# Anchor Browser — remote cloud browser sessions and agent tasks
ANCHORBROWSER_API_KEY=

# SurrealDB Agent Memory (SurrealDB Cloud context): host URL, context id and an sp- API key
SPECTRON_URL=
SPECTRON_CONTEXT_ID=
SPECTRON_API_KEY=

# Arize AX — OpenTelemetry/OpenInference tracing (Space settings → Space ID / API key)
ARIZE_SPACE_ID=
ARIZE_API_KEY=
